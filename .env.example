# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chave secreta: só no servidor, nunca no navegador nem no Git.
SUPABASE_SECRET_KEY=sb_secret_...

# Google Maps (opcional). Sem estas chaves, o mapa usa o OpenStreetMap gratuito.
# Chave do servidor: restrita à "Geocoding API" (busca os endereços dos clientes).
GOOGLE_MAPS_SERVER_KEY=
# Chave do navegador: restrita à "Maps JavaScript API" e aos sites do sistema.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Rastreio ao vivo do entregador (turno + GPS + mapas). Deixe vazio até existir o app Android.
NEXT_PUBLIC_RASTREIO_AO_VIVO=

# Pagamento online (Pix pelo site)
# Chave longa e aleatória que cifra os tokens das lojas (mínimo 32 caracteres). Não troque depois de usar.
PAYMENTS_SECRET_KEY=
# Aplicativo do Mercado Pago da plataforma (developers.mercadopago.com → Suas integrações).
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Opcional: assinatura secreta dos avisos (webhooks) do Mercado Pago.
MP_WEBHOOK_SECRET=
# Opcional: endereço público do site (para o retorno da conexão e os avisos). Ex.: https://pede-ai-e-va.vercel.app
APP_URL=
# Opcional: parte da plataforma em cada Pix, em % (0 = nada).
PAYMENTS_PLATFORM_FEE_PCT=0
# Só no computador de desenvolvimento: simulador de Pix sem dinheiro.
PAYMENTS_SIMULATOR=
