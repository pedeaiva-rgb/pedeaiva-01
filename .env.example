# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chave secreta: só no servidor, nunca no navegador nem no Git.
SUPABASE_SECRET_KEY=sb_secret_...

# Google Maps (opcional). Sem estas chaves, o mapa usa o OpenStreetMap gratuito.
# Chave do servidor: restrita à "Geocoding API" (busca os endereços dos clientes).
GOOGLE_MAPS_SERVER_KEY=
# Chave do navegador: restrita à "Maps JavaScript API" e aos sites do sistema.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Rastreio ao vivo do entregador (turno + GPS + mapas). Deixe vazio até existir o app Android.
NEXT_PUBLIC_RASTREIO_AO_VIVO=
